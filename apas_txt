import flet as ft
import threading
import asyncio

def main(page: ft.Page):
    page.title = "لوحة عباس"
    page.theme_mode = ft.ThemeMode.DARK
    page.rtl = True
    page.vertical_alignment = ft.MainAxisAlignment.CENTER
    page.horizontal_alignment = ft.CrossAxisAlignment.CENTER

    info_text = ft.Text("التطبيق فتح بنجاح! 🟢", size=20, weight="bold", color=ft.colors.GREEN)
    log_text = ft.Text("اضغط فحص المكتبة للتأكد من وجود pyrofork", size=14, color=ft.colors.WHITE70)

    def check_pyrofork(e):
        log_text.value = "جاري التحقق من المكتبة..."
        page.update()
        
        def run_test():
            try:
                from pyrogram import Client
                log_text.value = "✅ مكتبة pyrofork شغالة وجاهزة 100% وبدون مشاكل!"
                log_text.color = ft.colors.CYAN
            except Exception as err:
                log_text.value = f"❌ خطأ بالمكتبة: {str(err)}"
                log_text.color = ft.colors.RED
            page.update()

        threading.Thread(target=run_test, daemon=True).start()

    check_btn = ft.ElevatedButton("فحص اتصال pyrofork 🔍", on_click=check_pyrofork)

    page.add(
        ft.Icon(ft.icons.ROCKET_LAUNCH, size=50, color=ft.colors.AMBER),
        info_text,
        ft.Divider(),
        check_btn,
        log_text
    )

ft.app(target=main)
