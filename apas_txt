import flet as ft
import threading

def main(page: ft.Page):
    page.title = "لوحة عباس 👑"
    page.theme_mode = ft.ThemeMode.DARK
    page.rtl = True
    page.horizontal_alignment = ft.CrossAxisAlignment.CENTER
    page.vertical_alignment = ft.MainAxisAlignment.CENTER
    
    info = ft.Text("التطبيق شغال 100% 🟢", size=24, weight="bold", color=ft.colors.GREEN)
    status = ft.Text("اضغط الزر لفحص التليجرام", color=ft.colors.WHITE70)
    
    def check_telegram(e):
        status.value = "جاري الفحص... ⏳"
        page.update()
        
        def run_test():
            try:
                import pyrogram
                status.value = "✅ مكتبة pyrofork شغالة وموجودة! تكدر تضيف كود البوت هسه."
                status.color = ft.colors.CYAN
            except Exception as ex:
                status.value = f"❌ خطأ بالمكتبة: {str(ex)}"
                status.color = ft.colors.RED
            page.update()
            
        # تشغيل الفحص بخيط معزول حتى ما تجمد الشاشة
        threading.Thread(target=run_test, daemon=True).start()

    btn = ft.ElevatedButton("فحص مكتبة التليجرام 🚀", on_click=check_telegram, bgcolor=ft.colors.BLUE_700, color=ft.colors.WHITE)
    
    page.add(
        ft.Icon(ft.icons.ROCKET_LAUNCH, size=60, color=ft.colors.AMBER),
        info,
        ft.Divider(),
        btn,
        status
    )

ft.app(target=main)
